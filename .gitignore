build/
build-make/
external/
.DS_Store

# Standalone test binaries (built by hand outside cmake)
dsptests

# Licence tools build output, and the licence SIGNING seed (private key).
# The public half is source/LicencePublicKey.h, which IS committed.
build-licence/
licence-dev/
*signing-seed*.hex

# Installer outputs. The machinery is tracked; what it produces is not.
# Released packages are GitHub Release assets against a tag, not commits - git
# never forgets a binary. Ignoring them also means an UNSIGNED local build can
# never be swept in by a `git add -A`.
installer/build/
installer/*.pkg
installer/.built-from

# Signing material. None of this should ever be in a repository.
*.cer
*.certSigningRequest
*.p12
*.pfx
*.p8
AuthKey_*

# Scratch output from Claude sessions (plots, renders) - not part of the project.
Claude outputs/
